{
  "name": "@quietpulse/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "QuietPulse Windows Desktop Application (Electron + React + Shared Core)",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build:renderer": "vite build",
    "dist:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.quietpulse.desktop",
    "productName": "QuietPulse",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "scripts/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@quietpulse/shared": "file:../shared",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3"
  }
}
